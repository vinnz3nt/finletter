# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Gmail SMTP (use an App Password, not your account password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password

# Addressing
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# The two LLM-sourced blocks — the opening "global economy" summary and the
# closing "Next week" look-ahead — are fetched via the Claude Code CLI.
# All optional — if the `claude` binary is missing both blocks are skipped.
# CLAUDE_BIN=claude              # path to the Claude Code CLI
# NEWS_MODEL=                    # optional model id passed to `claude --model`
# NEWS_TIMEOUT_SECONDS=300       # subprocess timeout, per fetch
